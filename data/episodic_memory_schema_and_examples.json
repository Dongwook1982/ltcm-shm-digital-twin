{
  "_comment": "LTCM Episodic Memory Record Schema and Representative Examples. Actual operational records are confidential; these are representative examples illustrating the data format. Corresponding to Sec 3.1 and Appendix A of the main manuscript.",
  "_paper": "Signal-Driven Lifecycle Memory for SHM Digital Twins (submitted to MSSP, 2026)",
  "_author": "Dong-Wook Kim, DL E&C Co., Ltd.",

  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LTCM Episodic Memory Record",
    "description": "Formally defined as E = {e_i | e_i = (t_i, loc_i, type_i, sig_i, outcome_i)}",
    "type": "object",
    "required": ["memory_id","memory_type","timestamp","asset_guid","event_type","severity_score","signal_values","significance_score","memory_tier"],
    "properties": {
      "memory_id":        {"type":"string",  "description":"Unique identifier: [Case]-[EventType]-[YYYY]-[Location]"},
      "memory_type":      {"type":"string",  "enum":["Episodic","Semantic","Procedural","Predictive"]},
      "timestamp":        {"type":"string",  "format":"date-time"},
      "asset_guid":       {"type":"string",  "description":"IFC 4.3 element GUID (22-character base64url)"},
      "asset_class":      {"type":"string",  "enum":["bridge","railway","road"]},
      "asset_label":      {"type":"string",  "description":"Human-readable element label, e.g. 'Span 9 / Track Geometry'"},
      "event_type":       {"type":"string",  "enum":["sensor_anomaly","inspection","work_order","emergency","routine_survey"]},
      "severity_score":   {"type":"number",  "minimum":0,"maximum":1, "description":"Normalized severity ∈ [0,1]"},
      "signal_values":    {"type":"object",  "description":"Key-value map of sensor readings with units"},
      "significance_score":{"type":"number", "minimum":0,"maximum":1, "description":"S(m) = w1*sev + w2*uniq + w3*decay"},
      "uniqueness_score": {"type":"number",  "minimum":0,"maximum":1, "description":"1 - max_sim(m, E)"},
      "memory_tier":      {"type":"string",  "enum":["hot","warm","cold"]},
      "outcome":          {"type":"string",  "description":"Maintenance outcome or follow-up action"},
      "related_records":  {"type":"array",   "items":{"type":"string"}, "description":"IDs of causally related records"},
      "provenance":       {"type":"object",  "properties":{"source_system":{"type":"string"}, "operator":{"type":"string"}, "recorded_by":{"type":"string"}}}
    }
  },

