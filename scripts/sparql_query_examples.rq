# =============================================================================
# LTCM Knowledge Graph — Representative SPARQL 1.1 Query Examples
# Apache Jena Fuseki 4.9.0 endpoint: http://localhost:3030/ltcm/sparql
# Dong-Wook Kim, DL E&C Co., Ltd.
#
# USAGE: Copy and run ONE query block at a time.
#        This file contains 10 separate SELECT queries; SPARQL parsers
#        accept only one query per request. Each query is separated by a
#        blank line and begins with the shared PREFIX block (copy the
#        PREFIX declarations together with the query body).
#
# Example (single query):
#   curl -X POST http://localhost:3030/ltcm/sparql \
#     -H "Accept: application/json" \
#     --data-urlencode "query=PREFIX ltcm: <https://ltcm.dlenc.kr/ontology#>
#   PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
#   PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
#   SELECT ... WHERE { ... }"
#
# Alternatively, save each query block to its own file (query01.rq, etc.)
# and run: curl -X POST ... --data-urlencode query@query01.rq
# =============================================================================

# ── Shared PREFIX block (include with every query) ──────────────────────────
PREFIX ltcm: <https://ltcm.dlenc.kr/ontology#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 1: Retrieve all episodic records for a specific asset (by IFC GUID)
# Corresponds to Q-E-07: "Span 2 bearing replacement history"
# Run this block alone (PREFIX + SELECT).
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?record_id ?timestamp ?event_type ?severity ?content ?outcome
WHERE {
  ?record a ltcm:EpisodicRecord ;
          ltcm:hasIFCGUID "5F6A7B8C9D0E1F2A3B4C5D6E" ;
          ltcm:hasTimestamp ?timestamp ;
          rdfs:label ?record_id ;
          ltcm:hasSeverityScore ?severity .
  OPTIONAL { ?record ltcm:eventType ?event_type }
  OPTIONAL { ?record rdfs:comment ?content }
  OPTIONAL { ?record ltcm:outcome ?outcome }
}
ORDER BY ?timestamp


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 2: Find all high-severity events (severity > 0.80) on bridge assets
# Used for: Proactive inspection trigger queries
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?record_id ?guid ?severity ?timestamp ?event_type
WHERE {
  ?record a ltcm:EpisodicRecord ;
          ltcm:hasSeverityScore ?severity ;
          ltcm:hasTimestamp ?timestamp ;
          ltcm:hasIFCGUID ?guid ;
          ltcm:hasAssetClass "bridge" ;
          rdfs:label ?record_id .
  OPTIONAL { ?record ltcm:eventType ?event_type }
  FILTER (?severity > 0.80)
}
ORDER BY DESC(?severity)


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 3: Retrieve design code threshold for track settlement
# Semantic memory retrieval — corresponds to Q-S-01
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?node_id ?code_ref ?threshold_value ?unit ?comment
WHERE {
  ?node a ltcm:SemanticNode ;
        ltcm:hasDesignCodeRef ?code_ref ;
        ltcm:hasMeasurementVal ?threshold_value ;
        ltcm:hasMeasurementUnit ?unit ;
        rdfs:label ?node_id .
  OPTIONAL { ?node rdfs:comment ?comment }
  FILTER CONTAINS(?code_ref, "C-14020")
}


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 4: Find all episodic records that PRECEDED an emergency event
# Multi-hop temporal chain: prior_record → (precedesEvent) → emergency_record
# Corresponds to: BR-011 root-cause investigation (Q-E-08 pattern)
#
# Fix note: The original had a self-referential triple
#   ?emergency_record ltcm:precedesEvent ?emergency_record  [WRONG]
# Corrected to two distinct variables:
#   ?prior_record ltcm:precedesEvent ?emergency_record      [CORRECT]
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?prior_record ?prior_label ?timestamp ?severity
WHERE {
  ?emergency_record rdfs:label "C-BR-2020-EMG-SP4B" .
  ?prior_record ltcm:precedesEvent ?emergency_record ;
                ltcm:hasTimestamp ?timestamp ;
                ltcm:hasSeverityScore ?severity ;
                rdfs:label ?prior_label .
}
ORDER BY ?timestamp


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 5: Retrieve procedural memory — inspection protocol for settlement
# Corresponds to Q-PR-01
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?procedure_id ?trigger_condition ?step_sequence ?code_ref
WHERE {
  ?procedure a ltcm:ProceduralGraph ;
             ltcm:hasTriggerCondition ?trigger_condition ;
             rdfs:label ?procedure_id ;
             ltcm:hasDesignCodeRef ?code_ref .
  OPTIONAL { ?procedure rdfs:comment ?step_sequence }
  FILTER CONTAINS(?trigger_condition, "settlement")
}


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 6: Retrieve PINN forecast with confidence interval for specific asset
# Predictive memory retrieval — corresponds to Q-PD-01
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?forecast_id ?failure_prob ?ci_lower ?ci_upper ?pinn_model ?timestamp
WHERE {
  ?forecast a ltcm:PredictiveRecord ;
            ltcm:hasIFCGUID "2C3D4E5F6A7B8C9D0E1F2A3B" ;
            ltcm:hasFailureProbab ?failure_prob ;
            ltcm:hasConfIntervalLo ?ci_lower ;
            ltcm:hasConfIntervalHi ?ci_upper ;
            ltcm:hasPINNModelRef ?pinn_model ;
            ltcm:hasTimestamp ?timestamp ;
            rdfs:label ?forecast_id .
}
ORDER BY DESC(?timestamp)
LIMIT 1


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 7: Cross-memory-type — episodic records linked to procedural memory
# Multi-hop: Episodic → causedBy → FailureMode → ProceduralGraph
# Corresponds to multi-hop query type in evaluation (MAP@5 = 0.871)
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?record_id ?failure_mode ?procedure_id ?trigger
WHERE {
  ?record a ltcm:EpisodicRecord ;
          ltcm:causedBy ?failure_mode_node ;
          ltcm:hasTimestamp ?ts ;
          rdfs:label ?record_id .
  ?failure_mode_node rdfs:label ?failure_mode .
  OPTIONAL {
    ?procedure a ltcm:ProceduralGraph ;
               ltcm:hasTriggerCondition ?trigger ;
               rdfs:label ?procedure_id .
    FILTER CONTAINS(?trigger, STR(?failure_mode))
  }
  FILTER (?ts > "2018-01-01T00:00:00"^^xsd:dateTime)
  FILTER (?ts < "2024-01-01T00:00:00"^^xsd:dateTime)
}
ORDER BY DESC(?ts)
LIMIT 30


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 8: Retrieve spatially adjacent assets with their latest severity scores
# Used for: spatial overlap dimension in MARG scoring (δ=0.15)
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?target_asset_guid ?adjacent_asset_guid ?latest_severity ?ts
WHERE {
  ?target ltcm:hasIFCGUID "1B2C3D4E5F6A7B8C9D0E1F2A" ;
          ltcm:spatiallyAdjacentTo ?adjacent .
  ?adjacent ltcm:hasIFCGUID ?adjacent_asset_guid .
  ?record a ltcm:EpisodicRecord ;
          ltcm:anchorsTo ?adjacent ;
          ltcm:hasSeverityScore ?latest_severity ;
          ltcm:hasTimestamp ?ts .
  {
    SELECT ?adjacent (MAX(?t) AS ?max_t) WHERE {
      ?r a ltcm:EpisodicRecord ;
         ltcm:anchorsTo ?adjacent ;
         ltcm:hasTimestamp ?t .
    } GROUP BY ?adjacent
  }
  FILTER (?ts = ?max_t)
  BIND("1B2C3D4E5F6A7B8C9D0E1F2A" AS ?target_asset_guid)
}


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 9: Memory tier distribution (hot/warm/cold) — analytics
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?tier (COUNT(?record) AS ?count) (AVG(?significance) AS ?avg_significance)
WHERE {
  ?record a ltcm:MemoryRecord ;
          ltcm:hasMemoryTier ?tier ;
          ltcm:hasSignificance ?significance .
}
GROUP BY ?tier
ORDER BY ?tier


# ─────────────────────────────────────────────────────────────────────────────
# QUERY 10: CLS-LTCM consolidation candidates
# Records where significance < τ=0.30 (candidates for consolidation into Semantic)
# Note: Final consolidation decision requires TransE embedding similarity check
# (not expressible in pure SPARQL); this query identifies structural candidates.
# ─────────────────────────────────────────────────────────────────────────────
SELECT ?record_id ?significance ?tier ?failure_mode
WHERE {
  ?record a ltcm:EpisodicRecord ;
          ltcm:hasSignificance ?significance ;
          ltcm:hasMemoryTier ?tier ;
          ltcm:causedBy ?fm_node ;
          rdfs:label ?record_id .
  ?fm_node rdfs:label ?failure_mode .
  FILTER (?significance < 0.30)
  FILTER (?tier = "cold")
}
ORDER BY ?significance
LIMIT 100
